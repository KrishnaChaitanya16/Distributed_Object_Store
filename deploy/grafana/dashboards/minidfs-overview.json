    {
      "id": 5,
      "type": "stat",
      "title": "Dedup hit rate",
      "description": "Share of chunks skipped because an identical chunk already existed",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(minidfs_chunks_dedup_total) / clamp_min(sum(minidfs_chunks_dedup_total) + sum(minidfs_chunks_new_total), 1)",
          "legendFormat": "",
          "refId": "A",
          "datasource": "Prometheus"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "5xx responses",
      "description": "",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(minidfs_http_requests_total{code=~\"5..\"}) or vector(0)",
