        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Upload latency",
      "description": "HTTP latency of the upload handler; quantiles are estimated from histogram buckets",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(minidfs_http_request_duration_seconds_bucket{handler=\"upload\"}[$__rate_interval])))",
          "legendFormat": "P50",
          "refId": "A",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(minidfs_http_request_duration_seconds_bucket{handler=\"upload\"}[$__rate_interval])))",
          "legendFormat": "P95",
          "refId": "B",
          "datasource": "Prometheus"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(minidfs_http_request_duration_seconds_bucket{handler=\"upload\"}[$__rate_interval])))",
          "legendFormat": "P99",
          "refId": "C",
          "datasource": "Prometheus"
